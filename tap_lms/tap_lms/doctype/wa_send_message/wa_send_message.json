   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "origin",
   "fieldtype": "Select",
   "label": "Origin",
   "options": "Batch Wave\nDirect Reply\nAuto Reply Rule\nExternal",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "What produced this row. Batch Wave: a WA Send Batch wave. Direct Reply: a manual or AI-approved reply to one turn. Auto Reply Rule: a keyword-rule send. External: discovered via BigQuery, not sent from this dashboard."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Sent\nFailed",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "A row is written only once there is an outcome. In-flight wave progress lives on WA Send Batch, never a Pending row here."
