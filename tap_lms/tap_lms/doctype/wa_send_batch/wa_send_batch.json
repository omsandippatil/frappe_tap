   "in_list_view": 1
  },
  {
   "fieldname": "target_type",
   "fieldtype": "Select",
   "label": "Target Type",
   "options": "Group\nCollection\nGeo",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_wsb_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nScheduled\nThrottling\nSent\nPartially Failed\nFailed\nCancelled",
