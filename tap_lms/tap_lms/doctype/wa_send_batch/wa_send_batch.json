  },
  {
   "fieldname": "media_url",
   "fieldtype": "Data",
   "label": "Media URL",
   "depends_on": "eval:doc.send_kind=='Media'",
   "description": "Alternative to Media File: a public URL Glific's servers can fetch directly."
  },
  {
   "fieldname": "media_type",
   "fieldtype": "Select",
   "label": "Media Type",
   "options": "image\nvideo\ndocument\naudio",
   "depends_on": "eval:doc.send_kind=='Media'",
   "description": "Auto-detected from the uploaded file's MIME type. Correct manually if detection is wrong."
  },
  {
   "fieldname": "flow_section",
   "fieldtype": "Section Break",
   "label": "Flow",
   "depends_on": "eval:doc.send_kind=='Flow'"
  },
  {
   "fieldname": "glific_flow_id",
   "fieldtype": "Data",
   "label": "Glific Flow ID"
  },
  {
   "fieldname": "poll_section",
   "fieldtype": "Section Break",
   "label": "Poll",
   "depends_on": "eval:doc.send_kind=='Poll'"
  },
  {
   "fieldname": "poll_uuid",
   "fieldtype": "Data",
   "label": "Poll UUID",
   "depends_on": "eval:doc.send_kind=='Poll' && !doc.is_multi_language_poll",
   "description": "Single poll sent to every targeted group regardless of language."
  },
  {
   "fieldname": "is_multi_language_poll",
   "fieldtype": "Check",
   "label": "Multi-Language Poll",
   "default": "0",
   "description": "Send a different poll variant per group, matched on each group's Group Language."
  },
  {
   "fieldname": "poll_languages",
   "fieldtype": "Table",
   "label": "Poll Language Variants",
   "options": "WA Campaign Poll Language",
   "depends_on": "eval:doc.send_kind=='Poll' && doc.is_multi_language_poll",
   "description": "One row per language. Exactly one row should be marked Default, used for any targeted group with no Group Language set or whose language has no matching row here."
  },
  {
   "fieldname": "poll_response_window_hours",
   "fieldtype": "Int",
   "label": "Poll Response Window Hours",
   "default": "4",
   "depends_on": "eval:doc.send_kind=='Poll'",
   "description": "How many hours after this poll is sent a reply from a targeted group still counts as a response to this campaign (sets WA Group Turn.related_campaign). Defaults to 4 hours if left blank."
  },
  {
   "fieldname": "wave_section",
   "fieldtype": "Section Break",
   "label": "Throttling"
  },
  {
   "fieldname": "wave_size",
   "fieldtype": "Int",
   "label": "Wave Size",
   "description": "Groups sent per wave. Defaults from WA Bot Settings. Only relevant when the resolved target exceeds one wave."
  },
  {
   "fieldname": "wave_gap_minutes",
   "fieldtype": "Int",
   "label": "Wave Gap Minutes",
   "description": "Minutes between waves. Defaults from WA Bot Settings. Editable live, even mid-send."
  },
  {
   "fieldname": "column_break_wsb_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "resolved_target_groups",
   "fieldtype": "Long Text",
   "label": "Resolved Target Groups",
   "read_only": 1,
   "description": "JSON array of WA Group names, resolved once when the batch is scheduled, not at draft time. Wave membership is a slice of this list, never a separate stored row."
  },
  {
   "fieldname": "total_groups",
   "fieldtype": "Int",
   "label": "Total Groups",
   "read_only": 1
  },
  {
   "fieldname": "waves_total",
   "fieldtype": "Int",
   "label": "Waves Total",
   "read_only": 1
  },
  {
   "fieldname": "waves_sent",
   "fieldtype": "Int",
   "label": "Waves Sent",
   "read_only": 1
  },
  {
   "fieldname": "next_wave_at",
   "fieldtype": "Datetime",
   "label": "Next Wave At",
   "read_only": 1,
   "description": "Polled by the frontend to show time remaining until the next wave fires."
  },
  {
   "fieldname": "reach_section",
   "fieldtype": "Section Break",
   "label": "Reach"
  },
  {
   "fieldname": "real_target_group_count",
   "fieldtype": "Int",
   "label": "Real Target Group Count",
   "read_only": 1,
   "description": "Number of WA Groups this batch would reach in Prod Mode, stamped at expansion time even if Test Mode redirects the actual sends."
  },
  {
   "fieldname": "sent_in_test_mode",
   "fieldtype": "Check",
   "label": "Sent In Test Mode",
   "default": "0",
   "read_only": 1
  },
  {
