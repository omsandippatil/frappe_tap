   "fieldname": "column_break_wsb_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "media_file",
   "fieldtype": "Attach",
   "label": "Media File",
   "depends_on": "eval:doc.send_kind=='Media'",
