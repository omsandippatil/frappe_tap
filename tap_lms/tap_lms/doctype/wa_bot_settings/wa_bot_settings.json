   "label": "Test WA Group",
   "options": "WA Group",
   "mandatory_depends_on": "eval:doc.bot_mode=='Test'",
   "description": "Every send is redirected here while Bot Mode is Test. Use the Group Picker below (searchable by name) rather than typing a Glific ID directly."
